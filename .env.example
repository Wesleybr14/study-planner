# ============================================
# Study Planner - Modelo de variáveis de ambiente
# ============================================
# Copie este arquivo para ".env.local" e preencha com suas chaves.
# Na Vercel, cadastre estas mesmas variáveis em:
# Project > Settings > Environment Variables

# Google Gemini (grátis) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelos do Gemini em ordem de preferência, separados por vírgula.
# Se vazia, usa a lista padrão definida em lib/gemini.ts.
GEMINI_MODELS=

# Google Cloud - YouTube Data API v3 (grátis)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Opcional: chave para a Books API do Google (complemento; a Open Library é a
# fonte principal e não precisa de chave). Se vazia, usa a YOUTUBE_API_KEY.
GOOGLE_BOOKS_API_KEY=

# Supabase (login + banco) - https://supabase.com
# Pegue em: Settings > API do seu projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
